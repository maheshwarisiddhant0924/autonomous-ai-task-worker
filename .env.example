# LLM Provider Configuration
# Provide ONE of the following API keys based on your chosen provider:
OPENAI_API_KEY=sk-your-openai-key-here
GROQ_API_KEY=
HUGGINGFACE_API_KEY=

# Model configuration
# For OpenAI: gpt-4o
# For Groq: qwen/qwen3.8-27b
# For Hugging Face: meta-llama/Meta-Llama-3.1-8B-Instruct
MODEL_NAME=gpt-4o
TEMPERATURE=0.0

# Mock ERP
ERP_BASE_URL=http://localhost:8000
ERP_USERNAME=admin
ERP_PASSWORD=admin123

# Budget limits
MAX_STEPS=40
MAX_TOKENS=100000
MAX_COST_USD=0.50

# Paths
INVOICE_DIR=./invoices
SQLITE_DB=./data/erp.db
STATE_DB=./data/agent_state.db

# Logging
LOG_LEVEL=INFO
AUDIT_LOG=./logs/audit.jsonl
