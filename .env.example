# OpenAI API Key (required)
OPENAI_API_KEY=sk-your-key-here

# Model configuration
MODEL_NAME=gpt-4o
TEMPERATURE=0.0

# Mock ERP
ERP_BASE_URL=http://localhost:8000
ERP_USERNAME=admin
ERP_PASSWORD=admin123

# Budget limits
MAX_STEPS=40
MAX_TOKENS=100000
